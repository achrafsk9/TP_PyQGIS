  border: 1px solid #E8EAF3;
  border-radius: 8px;
  padding: 9px 11px;
}
#labelNombreObjets { color: #4338CA; font-size: 24px; font-weight: 700; }

QComboBox, QLineEdit {
  background-color: #FFFFFF;
  color: #111827;
  border: 1px solid #CBD2E0;
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 13px;
  selection-background-color: #4F46E5;
  selection-color: #FFFFFF;
}
QComboBox:hover, QLineEdit:hover { border-color: #818CF8; }
QComboBox:focus, QLineEdit:focus { border: 2px solid #4F46E5; }
QComboBox QAbstractItemView {
  background-color: #FFFFFF;
  color: #111827;
  border: 1px solid #CBD2E0;
  selection-background-color: #4F46E5;
  selection-color: #FFFFFF;
}

QPushButton {
  background-color: #FFFFFF;
  color: #374151;
  border: 1px solid #CBD2E0;
  border-radius: 8px;
  padding: 8px 22px;
  font-size: 13px;
  font-weight: 600;
}
QPushButton:hover { background-color: #FEF2F2; color: #B91C1C; border-color: #FCA5A5; }
QPushButton:pressed { background-color: #FEE2E2; }
